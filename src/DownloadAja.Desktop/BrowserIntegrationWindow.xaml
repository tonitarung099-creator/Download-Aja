<Window x:Class="DownloadAja.Desktop.BrowserIntegrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Integrasi Chrome - Download Aja"
        Width="700" Height="520"
        MinWidth="660" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Integrasi Google Chrome"
                   FontSize="23" FontWeight="SemiBold" Foreground="#0F172A"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,18" Foreground="#64748B" TextWrapping="Wrap"
                   Text="Pasang extension dari folder portable, lalu daftarkan ID extension agar Chrome dapat mengirim download ke aplikasi."/>

        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
            <StackPanel>
                <TextBlock Text="1. Muat extension" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Margin="0,6,0,10" Foreground="#475569" TextWrapping="Wrap"
                           Text="Buka chrome://extensions → aktifkan Mode developer → klik “Muat yang belum dikemas / Load unpacked” → pilih folder extension di bawah."/>
                <TextBox x:Name="ExtensionPathBox" IsReadOnly="True" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Click="OpenChromeExtensions_Click">Buka chrome://extensions</Button>
                    <Button Click="OpenExtensionFolder_Click">Buka Folder Extension</Button>
                    <Button Click="CopyExtensionPath_Click">Salin Path</Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,14,0,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="2. Masukkan ID extension" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Margin="0,4,0,8" Foreground="#64748B"
                               Text="Salin ID 32 karakter yang tampil pada kartu extension Download Aja."/>
                    <TextBox x:Name="ExtensionIdBox" Width="420" HorizontalAlignment="Left"
                             Height="32" MaxLength="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Bottom" Margin="14,0,0,0"
                        Click="Register_Click" FontWeight="SemiBold">
                    Daftarkan Integrasi
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="4" Margin="0,14,0,0" Background="#F8FAFC" CornerRadius="8" Padding="12">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
        </Border>

        <TextBlock Grid.Row="5" Margin="0,14,0,0" Foreground="#64748B" TextWrapping="Wrap"
                   Text="Pendaftaran memakai registry pengguna (HKCU), sehingga tidak membutuhkan hak Administrator. Setelah mendaftar, tutup dan buka kembali Chrome jika koneksi belum langsung aktif."/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Click="Unregister_Click">Hapus Integrasi</Button>
            <Button IsCancel="True">Tutup</Button>
        </StackPanel>
    </Grid>
</Window>
