<Window x:Class="DownloadAja.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Aja" Height="720" Width="1220"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="10,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Click="AddUrl_Click" FontWeight="SemiBold">＋ Tambah URL</Button>
                    <Button Click="Start_Click">▶ Mulai/Lanjut</Button>
                    <Button Click="StartQueue_Click">▶▶ Mulai Antrean</Button>
                    <Button Click="Pause_Click">⏸ Jeda</Button>
                    <Button Click="Stop_Click">■ Hentikan</Button>
                    <Button Click="Delete_Click">🗑 Hapus</Button>
                    <Button Click="OpenFolder_Click">📁 Buka Folder</Button>
                    <Button Click="Scheduler_Click">🕒 Scheduler</Button>
                    <Button Click="BrowserIntegration_Click">🌐 Browser</Button>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="DOWNLOAD AJA" VerticalAlignment="Center"
                           HorizontalAlignment="Center" FontWeight="Bold" FontSize="18" Foreground="#0F172A"/>
                <Button Grid.Column="2" Click="Settings_Click">⚙ Pengaturan</Button>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="EngineStatusText" Text="Menyiapkan mesin download..."/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="SpeedStatusText" Text="Kecepatan: 0 B/s"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ActiveStatusText" Text="Aktif: 0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="QueueStatusText" Text="Antrean: 0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="SchedulerStatusText" Text="Scheduler: nonaktif"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="DOWNLOAD" FontSize="11" Foreground="#64748B" FontWeight="Bold" Margin="8,8,8,5"/>
                        <ListBox x:Name="StatusFilterList"
                                 SelectedIndex="0"
                                 SelectionChanged="StatusFilter_SelectionChanged"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <ListBoxItem Tag="Semua" Padding="10,8">Semua</ListBoxItem>
                            <ListBoxItem Tag="Mengunduh" Padding="10,8">Mengunduh</ListBoxItem>
                            <ListBoxItem Tag="Antrean" Padding="10,8">Antrean</ListBoxItem>
                            <ListBoxItem Tag="Selesai" Padding="10,8">Selesai</ListBoxItem>
                            <ListBoxItem Tag="Belum selesai" Padding="10,8">Belum selesai</ListBoxItem>
                        </ListBox>

                        <TextBlock Text="KATEGORI" FontSize="11" Foreground="#64748B" FontWeight="Bold" Margin="8,20,8,5"/>
                        <ListBox x:Name="CategoryFilterList"
                                 SelectionChanged="CategoryFilter_SelectionChanged"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <ListBoxItem Tag="Video" Padding="10,8">Video</ListBoxItem>
                            <ListBoxItem Tag="Audio" Padding="10,8">Audio</ListBoxItem>
                            <ListBoxItem Tag="Dokumen" Padding="10,8">Dokumen</ListBoxItem>
                            <ListBoxItem Tag="Program" Padding="10,8">Program</ListBoxItem>
                            <ListBoxItem Tag="Arsip" Padding="10,8">Arsip</ListBoxItem>
                            <ListBoxItem Tag="Lainnya" Padding="10,8">Lainnya</ListBoxItem>
                        </ListBox>

                        <TextBlock Text="ALAT" FontSize="11" Foreground="#64748B" FontWeight="Bold" Margin="8,20,8,5"/>
                        <TextBlock Margin="10,6,8,0" Text="Antrean dapat dijalankan langsung atau dijadwalkan." TextWrapping="Wrap"
                                   Foreground="#64748B" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="14,12,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Daftar Download" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding DownloadDirectory, StringFormat=Lokasi default: {0}}"
                                   Foreground="#64748B" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Height="34"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="Cari nama file, URL, atau kategori"/>
                </Grid>

                <DataGrid x:Name="DownloadsGrid"
                          Grid.Row="1" Margin="14,0,14,14"
                          ItemsSource="{Binding DownloadsView}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#E2E8F0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="90"/>
                        <DataGridTextColumn Header="Ukuran" Binding="{Binding SizeText}" Width="155"/>
                        <DataGridTemplateColumn Header="Progres" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,3">
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="18"/>
                                        <TextBlock Text="{Binding ProgressText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/>
                        <DataGridTextColumn Header="Kecepatan" Binding="{Binding SpeedText}" Width="105"/>
                        <DataGridTextColumn Header="Sisa" Binding="{Binding EtaText}" Width="80"/>
                        <DataGridTextColumn Header="Alamat" Binding="{Binding Url}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
