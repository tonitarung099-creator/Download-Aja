<Window x:Class="DownloadAja.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Aja" Height="720" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="10,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Click="AddUrl_Click" FontWeight="SemiBold">＋ Tambah URL</Button>
                    <Button Click="Start_Click">▶ Mulai/Lanjut</Button>
                    <Button Click="Pause_Click">⏸ Jeda</Button>
                    <Button Click="Stop_Click">■ Hentikan</Button>
                    <Button Click="Delete_Click">🗑 Hapus</Button>
                    <Button IsEnabled="False" ToolTip="Akan ditambahkan pada tahap scheduler">🕒 Scheduler</Button>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="DOWNLOAD AJA" VerticalAlignment="Center"
                           HorizontalAlignment="Center" FontWeight="Bold" FontSize="18" Foreground="#0F172A"/>
                <Button Grid.Column="2" IsEnabled="False" ToolTip="Pengaturan lanjutan sedang dibangun">⚙ Pengaturan</Button>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="EngineStatusText" Text="Menyiapkan mesin download..."/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="SpeedStatusText" Text="Kecepatan: 0 B/s"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ActiveStatusText" Text="Aktif: 0"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <StackPanel Margin="12">
                    <TextBlock Text="DOWNLOAD" FontSize="11" Foreground="#64748B" FontWeight="Bold" Margin="8,8,8,5"/>
                    <ListBox SelectedIndex="0" BorderThickness="0" Background="Transparent">
                        <ListBoxItem Padding="10,8">Semua</ListBoxItem>
                        <ListBoxItem Padding="10,8">Mengunduh</ListBoxItem>
                        <ListBoxItem Padding="10,8">Selesai</ListBoxItem>
                        <ListBoxItem Padding="10,8">Belum selesai</ListBoxItem>
                    </ListBox>

                    <TextBlock Text="KATEGORI" FontSize="11" Foreground="#64748B" FontWeight="Bold" Margin="8,20,8,5"/>
                    <ListBox BorderThickness="0" Background="Transparent">
                        <ListBoxItem Padding="10,8">Video</ListBoxItem>
                        <ListBoxItem Padding="10,8">Audio</ListBoxItem>
                        <ListBoxItem Padding="10,8">Dokumen</ListBoxItem>
                        <ListBoxItem Padding="10,8">Program</ListBoxItem>
                        <ListBoxItem Padding="10,8">Arsip</ListBoxItem>
                    </ListBox>

                    <TextBlock Text="ALAT" FontSize="11" Foreground="#64748B" FontWeight="Bold" Margin="8,20,8,5"/>
                    <ListBox BorderThickness="0" Background="Transparent">
                        <ListBoxItem Padding="10,8">Antrean</ListBoxItem>
                        <ListBoxItem Padding="10,8">Scheduler</ListBoxItem>
                        <ListBoxItem Padding="10,8">Browser</ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="14,12,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Daftar Download" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding DownloadDirectory, StringFormat=Lokasi default: {0}}"
                                   Foreground="#64748B" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Height="34" VerticalContentAlignment="Center" Padding="10,0"
                             ToolTip="Pencarian akan diaktifkan pada tahap berikutnya"
                             IsEnabled="False"/>
                </Grid>

                <DataGrid x:Name="DownloadsGrid"
                          Grid.Row="1" Margin="14,0,14,14"
                          ItemsSource="{Binding Downloads}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#E2E8F0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Ukuran" Binding="{Binding SizeText}" Width="155"/>
                        <DataGridTextColumn Header="Progres" Binding="{Binding ProgressText}" Width="75"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/>
                        <DataGridTextColumn Header="Kecepatan" Binding="{Binding SpeedText}" Width="105"/>
                        <DataGridTextColumn Header="Sisa" Binding="{Binding EtaText}" Width="80"/>
                        <DataGridTextColumn Header="Alamat" Binding="{Binding Url}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
