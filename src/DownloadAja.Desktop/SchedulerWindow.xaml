<Window x:Class="DownloadAja.Desktop.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduler Download Aja"
        Width="500" Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Jadwalkan Antrean" FontSize="21" FontWeight="SemiBold" Foreground="#0F172A"/>
        <CheckBox x:Name="EnabledBox" Grid.Row="1" Margin="0,14,0,16"
                  Content="Aktifkan scheduler untuk memulai semua item Antrean"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Tanggal"/>
            <DatePicker x:Name="DateBox" Grid.Column="1" Height="32"/>
            <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Text="Jam"/>
            <TextBox x:Name="TimeBox" Grid.Column="3" Height="32" VerticalContentAlignment="Center"
                     Padding="8,0" ToolTip="Format HH:mm"/>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Foreground="#64748B" TextWrapping="Wrap"
                       Text="Scheduler satu kali. Setelah waktu tercapai, semua item berstatus Antrean akan dimulai dan scheduler otomatis dimatikan."/>
            <TextBlock x:Name="ValidationText" Foreground="#B91C1C" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button IsCancel="True">Batal</Button>
            <Button IsDefault="True" Click="Save_Click" FontWeight="SemiBold">Simpan</Button>
        </StackPanel>
    </Grid>
</Window>
