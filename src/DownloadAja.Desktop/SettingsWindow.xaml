<Window x:Class="DownloadAja.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan Download Aja"
        Width="560" Height="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Pengaturan Download" FontSize="21" FontWeight="SemiBold" Foreground="#0F172A"/>
        <TextBlock Grid.Row="1" Margin="0,7,0,18" Foreground="#64748B"
                   Text="Pengaturan ini disimpan di folder data portable."/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Koneksi per download"/>
            <ComboBox x:Name="ConnectionsBox" Grid.Column="1" Height="32" SelectedValuePath="Tag">
                <ComboBoxItem Content="1 koneksi" Tag="1"/>
                <ComboBoxItem Content="2 koneksi" Tag="2"/>
                <ComboBoxItem Content="4 koneksi" Tag="4"/>
                <ComboBoxItem Content="8 koneksi" Tag="8"/>
                <ComboBoxItem Content="16 koneksi" Tag="16"/>
            </ComboBox>

            <TextBlock Grid.Row="1" Margin="0,18,0,0" VerticalAlignment="Center"
                       Text="Download simultan saat antrean"/>
            <ComboBox x:Name="SimultaneousBox" Grid.Row="1" Grid.Column="1" Margin="0,18,0,0" Height="32" SelectedValuePath="Tag">
                <ComboBoxItem Content="1 download" Tag="1"/>
                <ComboBoxItem Content="2 download" Tag="2"/>
                <ComboBoxItem Content="3 download" Tag="3"/>
                <ComboBoxItem Content="4 download" Tag="4"/>
                <ComboBoxItem Content="5 download" Tag="5"/>
                <ComboBoxItem Content="8 download" Tag="8"/>
                <ComboBoxItem Content="10 download" Tag="10"/>
            </ComboBox>

            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="Batas kecepatan"/>
                <TextBlock Text="0 = tanpa batas" Foreground="#64748B" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,18,0,0">
                <TextBox x:Name="SpeedLimitBox" Width="130" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                <TextBlock Text="KB/s" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Margin="0,22,0,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel>
                <CheckBox x:Name="ClipboardMonitoringBox"
                          Content="Pantau clipboard untuk URL HTTP/HTTPS"/>
                <TextBlock Margin="24,5,0,0" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"
                           Text="Jika aktif, saat URL baru disalin aplikasi akan membuka dialog Tambah URL. Tidak ada isi clipboard yang dikirim keluar dari komputer."/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ValidationText" Grid.Row="4" Foreground="#B91C1C" Margin="0,16,0,0"/>

        <Grid Grid.Row="5">
            <Button HorizontalAlignment="Left" Click="Diagnostics_Click">Tentang &amp; Diagnostik</Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button IsCancel="True">Batal</Button>
                <Button IsDefault="True" Click="Save_Click" FontWeight="SemiBold">Simpan</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
