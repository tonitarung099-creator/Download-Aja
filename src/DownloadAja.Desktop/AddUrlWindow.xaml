<Window x:Class="DownloadAja.Desktop.AddUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah URL" Height="320" Width="640"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Alamat download" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <TextBox x:Name="UrlBox" Grid.Row="1" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>

        <TextBlock Grid.Row="2" Text="Simpan ke folder" FontWeight="SemiBold" Margin="0,16,0,7"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DirectoryBox" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
            <Button Grid.Column="1" Click="BrowseFolder_Click" Margin="8,0,0,0">Pilih Folder</Button>
        </Grid>

        <CheckBox x:Name="StartNowCheckBox"
                  Grid.Row="4"
                  Margin="0,16,0,0"
                  IsChecked="True"
                  Content="Mulai download sekarang (matikan untuk masuk antrean)"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button IsCancel="True">Batal</Button>
            <Button IsDefault="True" Click="Ok_Click" FontWeight="SemiBold">Tambahkan</Button>
        </StackPanel>
    </Grid>
</Window>
