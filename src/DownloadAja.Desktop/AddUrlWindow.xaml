<Window x:Class="DownloadAja.Desktop.AddUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah URL" Height="500" Width="660"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Alamat download" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <StackPanel Grid.Row="1">
            <TextBox x:Name="UrlBox" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                     TextChanged="UrlBox_TextChanged"/>
            <Border x:Name="YouTubeInfo"
                    Visibility="Collapsed"
                    Margin="0,8,0,0"
                    Padding="10"
                    CornerRadius="7"
                    Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="#1E3A8A" TextWrapping="Wrap"
                               Text="YouTube publik terdeteksi — Download Aja memakai yt-dlp + Deno + FFmpeg dan hanya mengambil satu video (bukan seluruh playlist)."/>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Kualitas:" VerticalAlignment="Center" Margin="0,0,9,0" FontWeight="SemiBold"/>
                        <ComboBox x:Name="YouTubeQualityBox" Grid.Column="1" SelectedIndex="0" Height="30">
                            <ComboBoxItem Tag="best">Terbaik tersedia</ComboBoxItem>
                            <ComboBoxItem Tag="2160p">Maks. 2160p (4K)</ComboBoxItem>
                            <ComboBoxItem Tag="1440p">Maks. 1440p (2K)</ComboBoxItem>
                            <ComboBoxItem Tag="1080p">Maks. 1080p</ComboBoxItem>
                            <ComboBoxItem Tag="720p">Maks. 720p</ComboBoxItem>
                            <ComboBoxItem Tag="480p">Maks. 480p</ComboBoxItem>
                            <ComboBoxItem Tag="360p">Maks. 360p</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Simpan ke folder" FontWeight="SemiBold" Margin="0,16,0,7"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DirectoryBox" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
            <Button Grid.Column="1" Click="BrowseFolder_Click" Margin="8,0,0,0">Pilih Folder</Button>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="Nama file (opsional)" FontWeight="SemiBold"/>
            <TextBlock Text="Kosongkan agar nama mengikuti URL/server."
                       Foreground="#64748B" FontSize="11" Margin="0,3,0,7"/>
            <TextBox x:Name="FileNameBox" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
        </StackPanel>

        <CheckBox x:Name="StartNowCheckBox"
                  Grid.Row="5"
                  Margin="0,16,0,0"
                  IsChecked="True"
                  Content="Mulai download sekarang (matikan untuk masuk antrean)"/>

        <TextBlock x:Name="ValidationText" Grid.Row="6" Foreground="#B91C1C" Margin="0,12,0,0"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button IsCancel="True">Batal</Button>
            <Button IsDefault="True" Click="Ok_Click" FontWeight="SemiBold">Tambahkan</Button>
        </StackPanel>
    </Grid>
</Window>
