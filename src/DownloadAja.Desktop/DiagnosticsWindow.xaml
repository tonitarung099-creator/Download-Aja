<Window x:Class="DownloadAja.Desktop.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tentang & Diagnostik - Download Aja"
        Width="760" Height="580"
        MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Download Aja" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Margin="0,4,0,0" Foreground="#64748B"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,12" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel>
                <TextBlock Text="Ringkasan Diagnostik" FontWeight="SemiBold"/>
                <TextBlock Margin="0,5,0,0" Foreground="#64748B" TextWrapping="Wrap"
                           Text="Informasi ini tidak berisi cookie atau password. Gunakan tombol Salin Diagnostik saat melaporkan error."/>
            </StackPanel>
        </Border>

        <TextBox x:Name="DiagnosticsBox"
                 Grid.Row="2"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextWrapping="NoWrap"/>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Click="Refresh_Click">Refresh</Button>
                <Button Click="Copy_Click">Salin Diagnostik</Button>
                <Button Click="OpenLogs_Click">Buka Folder Log</Button>
            </StackPanel>
            <Button HorizontalAlignment="Right" IsCancel="True">Tutup</Button>
        </Grid>
    </Grid>
</Window>
